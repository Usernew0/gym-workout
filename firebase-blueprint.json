{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Member user account profiles, hydration/body-weight trackers, preferences, and credentials",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "minLength": 2, "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "password": { "type": "string", "minLength": 4, "maxLength": 256 },
        "gender": { "type": "string", "maxLength": 32 },
        "weightUnitPreference": { "type": "string", "enum": ["kg", "lbs"] },
        "coupleId": { "type": "string", "maxLength": 128 },
        "role": { "type": "string", "maxLength": 32 },
        "telegramUsername": { "type": "string", "maxLength": 128 },
        "telegramChatId": { "type": "string", "maxLength": 64 },
        "telegramNotificationsEnabled": { "type": "boolean" },
        "waterIntake": { "type": "object" },
        "bodyWeightHistory": { "type": "array" },
        "restTimerPrefs": { "type": "object" },
        "twoFactorEnabled": { "type": "boolean" },
        "twoFactorSecret": { "type": "string", "maxLength": 256 },
        "twoFactorBackupCodes": { "type": "array" },
        "twoFactorCreatedAt": { "type": "string", "maxLength": 64 },
        "visibleTabs": { "type": "array" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "username"]
    },
    "AdminSetting": {
      "title": "AdminSetting",
      "description": "Platform admin settings, security policies, and Telegram bot configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 }
      },
      "required": ["id"]
    },
    "UserActivityLog": {
      "title": "UserActivityLog",
      "description": "Security audit trails and activity logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "username": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 2000 },
        "timestamp": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "username", "action", "details", "timestamp"]
    },
    "WorkoutPlan": {
      "title": "WorkoutPlan",
      "description": "Gym workout training plans, warm-ups, exercises, and weekly logs",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "ownerUsername": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 2000 },
        "instructions": { "type": "string", "maxLength": 20000 },
        "sheetName": { "type": "string", "maxLength": 256 },
        "defaultWeightUnit": { "type": "string", "enum": ["kg", "lbs"] },
        "weeks": { "type": "number" },
        "hasRpeColumn": { "type": "boolean" },
        "hasRirColumn": { "type": "boolean" },
        "warmupExercises": { "type": "array" },
        "warmupLogs": { "type": "object" },
        "exercises": { "type": "array" },
        "sourceFileName": { "type": "string", "maxLength": 256 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "assignedByAdmin": { "type": "boolean" },
        "progress": { "type": "object" },
        "exerciseLogs": { "type": "object" },
        "previousLogs": { "type": "object" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "ownerUsername", "title", "weeks", "exercises"]
    }
  },
  "firestore": {
    "userAccounts": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Member accounts, hydration, body weight, timer prefs, and profile credentials"
    },
    "adminSettings": {
      "schema": { "$ref": "#/entities/AdminSetting" },
      "description": "Platform admin settings and Telegram bot configuration"
    },
    "activityLogs": {
      "schema": { "$ref": "#/entities/UserActivityLog" },
      "description": "Security audit trails and activity logs"
    },
    "workoutPlans": {
      "schema": { "$ref": "#/entities/WorkoutPlan" },
      "description": "Gym training workout plans, exercises, warm-ups, and logs"
    }
  }
}
