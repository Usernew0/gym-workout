rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net catch-all: default-deny all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Common sanitization and validation helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ==========================================
    // ENTITY VALIDATION BLUEPRINTS (GYM WORKOUT)
    // ==========================================

    function isValidUserAccount(data) {
      return data.keys().hasAll(['id', 'username'])
        && data.keys().hasOnly([
          'id', 'username', 'displayName', 'password', 'role', 'gender',
          'weightUnitPreference', 'telegramUsername', 'telegramChatId',
          'telegramNotificationsEnabled', 'waterIntake', 'bodyWeightHistory',
          'restTimerPrefs', 'twoFactorEnabled', 'twoFactorSecret',
          'twoFactorBackupCodes', 'twoFactorCreatedAt', 'visibleTabs',
          'coupleId', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.username is string && data.username.size() >= 2 && data.username.size() <= 128
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('password' in data) || (data.password is string && data.password.size() <= 256))
        && (!('role' in data) || (data.role is string && data.role.size() <= 32))
        && (!('gender' in data) || (data.gender is string && data.gender.size() <= 32))
        && (!('weightUnitPreference' in data) || (data.weightUnitPreference is string && (data.weightUnitPreference == 'kg' || data.weightUnitPreference == 'lbs')))
        && (!('telegramUsername' in data) || (data.telegramUsername is string && data.telegramUsername.size() <= 128))
        && (!('telegramChatId' in data) || (data.telegramChatId is string && data.telegramChatId.size() <= 64))
        && (!('telegramNotificationsEnabled' in data) || data.telegramNotificationsEnabled is bool)
        && (!('waterIntake' in data) || data.waterIntake is map)
        && (!('bodyWeightHistory' in data) || (data.bodyWeightHistory is list && data.bodyWeightHistory.size() <= 2000))
        && (!('restTimerPrefs' in data) || data.restTimerPrefs is map)
        && (!('twoFactorEnabled' in data) || data.twoFactorEnabled is bool)
        && (!('twoFactorSecret' in data) || (data.twoFactorSecret is string && data.twoFactorSecret.size() <= 256))
        && (!('twoFactorBackupCodes' in data) || (data.twoFactorBackupCodes is list && data.twoFactorBackupCodes.size() <= 50))
        && (!('twoFactorCreatedAt' in data) || (data.twoFactorCreatedAt is string && data.twoFactorCreatedAt.size() <= 64))
        && (!('visibleTabs' in data) || (data.visibleTabs is list && data.visibleTabs.size() <= 20))
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidAdminSetting(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128;
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['id', 'username', 'action', 'details', 'timestamp'])
        && data.keys().hasOnly(['id', 'username', 'action', 'details', 'timestamp', 'coupleId', 'couple_id'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.username is string && data.username.size() <= 100
        && data.action is string && data.action.size() <= 100
        && data.details is string && data.details.size() <= 2000
        && data.timestamp is string && data.timestamp.size() <= 64
        && (!('coupleId' in data) || (data.coupleId is string && data.coupleId.size() <= 128))
        && (!('couple_id' in data) || (data.couple_id is string && data.couple_id.size() <= 128));
    }

    function isValidWorkoutPlan(data) {
      return data.keys().hasAll(['id', 'ownerUsername', 'title', 'weeks', 'exercises'])
        && data.keys().hasOnly([
          'id', 'ownerUsername', 'title', 'description', 'instructions',
          'sheetName', 'defaultWeightUnit', 'weeks', 'hasRpeColumn',
          'hasRirColumn', 'warmupExercises', 'warmupLogs', 'exercises',
          'sourceFileName', 'createdBy', 'assignedByAdmin', 'progress',
          'exerciseLogs', 'previousLogs', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.ownerUsername is string && data.ownerUsername.size() <= 128
        && data.title is string && data.title.size() <= 200
        && data.weeks is number && data.weeks >= 1 && data.weeks <= 104
        && data.exercises is list && data.exercises.size() <= 500
        && (!('description' in data) || (data.description is string && data.description.size() <= 2000))
        && (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 20000))
        && (!('sheetName' in data) || (data.sheetName is string && data.sheetName.size() <= 256))
        && (!('defaultWeightUnit' in data) || (data.defaultWeightUnit is string && (data.defaultWeightUnit == 'kg' || data.defaultWeightUnit == 'lbs')))
        && (!('hasRpeColumn' in data) || data.hasRpeColumn is bool)
        && (!('hasRirColumn' in data) || data.hasRirColumn is bool)
        && (!('warmupExercises' in data) || (data.warmupExercises is list && data.warmupExercises.size() <= 100))
        && (!('warmupLogs' in data) || data.warmupLogs is map)
        && (!('sourceFileName' in data) || (data.sourceFileName is string && data.sourceFileName.size() <= 256))
        && (!('createdBy' in data) || (data.createdBy is string && data.createdBy.size() <= 128))
        && (!('assignedByAdmin' in data) || data.assignedByAdmin is bool)
        && (!('progress' in data) || data.progress is map)
        && (!('exerciseLogs' in data) || data.exerciseLogs is map)
        && (!('previousLogs' in data) || data.previousLogs is map)
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // ==========================================
    // COLLECTION ACCESS RULES
    // ==========================================

    // Member accounts: Prevents account takeover, username hijacking, and 'admin' impersonation
    match /userAccounts/{userId} {
      allow read: if true;
      allow create: if isValidId(userId)
        && incoming().id == userId
        && isValidUserAccount(incoming())
        && ('password' in incoming() && incoming().password is string && incoming().password.size() >= 4 && incoming().password.size() <= 256)
        && incoming().username.lower() != 'admin';
      allow update: if isValidId(userId)
        && incoming().id == userId
        && (!('id' in existing()) || incoming().id == existing().id)
        && incoming().username.lower() == existing().username.lower()
        && isValidUserAccount(incoming())
        && (!('password' in existing()) || ('password' in incoming() && incoming().password is string && incoming().password.size() >= 4 && incoming().password.size() <= 256))
        && incoming().username.lower() != 'admin';
      allow delete: if isValidId(userId) && existing().username.lower() != 'admin';
    }

    // Admin settings: Protected against client deletion and ID poisoning
    match /adminSettings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && incoming().id == settingId && isValidAdminSetting(incoming());
      allow delete: if false;
    }

    // Activity logs: Append-only immutable audit trail
    match /activityLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId) && incoming().id == logId && isValidActivityLog(incoming());
      allow update: if false;
      allow delete: if isValidId(logId);
    }

    // Workout plans: Gym training sheets, warm-ups, weekly logs, and progress
    match /workoutPlans/{planId} {
      allow read: if true;
      allow create: if isValidId(planId) && incoming().id == planId && isValidWorkoutPlan(incoming());
      allow update: if isValidId(planId)
        && incoming().id == planId
        && (!('id' in existing()) || incoming().id == existing().id)
        && isValidWorkoutPlan(incoming());
      allow delete: if isValidId(planId);
    }

    // Startup connection ping document (read-only)
    match /_connection_test_metadata_/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
